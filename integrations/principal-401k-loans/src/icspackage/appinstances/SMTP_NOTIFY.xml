<?xml version="1.0" encoding="UTF-8"?>
<!--
  The built-in OIC notification service. Recipients are set through the
  notifyTo and notifyBusinessTo integration properties rather than pinned
  here, so a rota change does not need a redeploy.

  Nothing in the notification body carries a national identifier or an
  individual loan balance; see map_summary_to_notification.xsl.
-->
<appinstance xmlns="http://xmlns.oracle.com/ics/appinstance">
  <code>SMTP_NOTIFY</code>
  <name>Principal 401(k) Loans Notifications</name>
  <description>Completion and failure notifications for the Principal 401(k) loan file.</description>
  <adapterType>oraclecloudnotification</adapterType>
  <role>INVOKE</role>
  <properties/>
</appinstance>
